# ── Admin ──────────────────────────────────────────────
# Password for the admin panel (Settings → پنل مدیریت). REQUIRED in production.
ADMIN_PASSWORD=change-me
# Random secret used to sign the admin session cookie (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Payment ────────────────────────────────────────────
# mock      → fake payment page, for development/testing (default)
# zarinpal  → real Zarinpal gateway
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
# true → use sandbox.zarinpal.com (test gateway, no real money)
ZARINPAL_SANDBOX=true

# Public URL of the site (used for the payment callback), no trailing slash
APP_URL=http://localhost:3100

# Where the SQLite database file lives (must be on a persistent disk in production)
DATABASE_PATH=./data/lash.db

# ── SMS (confirmation, reminder, cancellation) ────────
# mock | kavenegar | smsir   (mock = nothing is sent, only logged in the admin panel)
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
# Optional: your dedicated Kavenegar line number
KAVENEGAR_SENDER=
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
# Reminders run every 5 min inside the server. Set "off" if you trigger them externally instead.
SMS_SCHEDULER=on
# Only needed for the external trigger: GET /api/cron/reminders  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

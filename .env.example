# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Milestone 4: chatbot (server-only — never prefix these with NEXT_PUBLIC_) ──
ANTHROPIC_API_KEY=
# Model from PROJECT_BRIEF.md. Change here to switch models without code changes.
CHAT_MODEL=claude-sonnet-4-6
# Questions per visitor per day (by session cookie and by IP)
CHAT_DAILY_LIMIT=10
# Supabase → Project Settings → API → service_role key (bypasses RLS; server only)
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to open /admin/knowledge
ADMIN_EMAILS=
# Any long random string; used to hash visitor IPs for rate limiting
CHAT_IP_SALT=
